<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. All in-app styling comes from the Compose theme tokens (ui/theme). -->
    <style name="Theme.Diacritica" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- "Look up in Diacritica": a see-through window, so the word sheet sits over the other app. -->
    <style name="Theme.Diacritica.Overlay" parent="Theme.Diacritica">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <color name="paper_ground">#FAF8F3</color>
    <color name="paper_ink">#1C1B19</color>
    <color name="paper_accent">#2B4FA8</color>
</resources>
